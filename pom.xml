<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 独立 API 项目：只包含对外契约（接口 / 事件 / 枚举 / 门面），不含插件本体实现。
         坐标与 JitPack 发布一致：com.github.mczju-ops:MCZJUInfernalMobs-API -->
    <groupId>com.github.mczju-ops</groupId>
    <artifactId>MCZJUInfernalMobs-API</artifactId>
    <version>1.3.1</version>
    <packaging>jar</packaging>
    <name>MCZJUInfernalMobs-API</name>
    <description>炒鸡怪对外 API：接口与事件（空接口 + 事件），供外部插件编译期依赖；运行时由 InfernalMobs 插件本体提供。</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- 仅编译期需要 Bukkit/Paper 类型；打包时由使用方（InfernalMobs 插件）shade 或服务端提供 -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>26.2.build.63-beta</version>
            <scope>provided</scope>
        </dependency>
        <!-- @NotNull / @Nullable 注解 -->
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>24.1.0</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>21</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
